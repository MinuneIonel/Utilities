{
  "name": "toolbox",
  "private": true,
  "version": "0.1.0",
  "description": "Toolbox: wire the Utilities tools together as a node graph",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "vite build && electron .",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@xyflow/react": "^12.12.0",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.62.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
