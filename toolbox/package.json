{
  "name": "toolbox",
  "private": true,
  "version": "0.1.0",
  "description": "Toolbox: wire the Utilities tools together as a node graph",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "vite build && electron .",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "check:gpu": "node test/gpu/run.mjs",
    "check:encode": "npm run build && node test/e2e/encode.mjs",
    "dist": "tsc --noEmit && vite build && electron-builder --mac dmg --arm64 --publish never",
    "pack": "vite build && electron-builder --dir",
    "dist:win": "tsc --noEmit && vite build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "tsc --noEmit && vite build && electron-builder --linux AppImage --x64 --publish never"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "@xyflow/react": "^12.12.0",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0",
    "gifenc": "^1.0.3",
    "mediabunny": "^1.62.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "productName": "Toolbox",
  "author": "Cojo",
  "build": {
    "appId": "dev.cojo.toolbox",
    "productName": "Toolbox",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "npmRebuild": false,
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "identity": "-",
      "extendInfo": {
        "NSCameraUsageDescription": "Webcam nodes use the camera to preview and record.",
        "NSMicrophoneUsageDescription": "Webcam nodes record the microphone's sound with the video."
      },
      "extraResources": [
        {
          "from": "../node_modules/ffmpeg-static/ffmpeg",
          "to": "ffmpeg"
        }
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Toolbox"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "extraResources": [
        {
          "from": "../node_modules/ffmpeg-static/ffmpeg",
          "to": "ffmpeg"
        }
      ]
    },
    "artifactName": "Toolbox-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "../node_modules/ffmpeg-static/ffmpeg.exe",
          "to": "ffmpeg.exe"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Toolbox"
    },
    "publish": null
  }
}
