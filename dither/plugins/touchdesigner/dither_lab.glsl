#define P_MATCH int(uParams2.w + 0.5)

// ---- Dither Lab core (generated by plugins/generate.ts; do not edit by hand) ----
// Mirrors the ordered, halftone and threshold modes of src/engine/dither.ts.
// Error diffusion processes pixels in sequence, so it has no shader version.

float dl_bit(float v, float i) { return mod(floor(v / exp2(i)), 2.0); }

// Recursive Bayer matrix by bit interleaving, normalised to [0, 1).
float dl_bayer(vec2 p, float levels) {
  float v = 0.0;
  for (int i = 0; i < 4; i++) {
    if (float(i) >= levels) break;
    float xb = dl_bit(p.x, float(i));
    float yb = dl_bit(p.y, float(i));
    v = v * 4.0 + 2.0 * abs(xb - yb) + yb;
  }
  return (v + 0.5) / exp2(levels * 2.0);
}

// Interleaved gradient noise (Jimenez 2014): cheap, evenly spread, no texture needed.
float dl_ign(vec2 p) { return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }

float dl_hash(vec2 p, float t) {
  return fract(sin(dot(p + fract(t * 0.618) * 113.0, vec2(12.9898, 78.233))) * 43758.5453);
}

float cdf_dot(float s) {
  s *= 16.0;
  if (s < 1.0) return mix(0.0, 0.098206, s - 0.0);
  if (s < 2.0) return mix(0.098206, 0.196518, s - 1.0);
  if (s < 3.0) return mix(0.196518, 0.294815, s - 2.0);
  if (s < 4.0) return mix(0.294815, 0.393158, s - 3.0);
  if (s < 5.0) return mix(0.393158, 0.452179, s - 4.0);
  if (s < 6.0) return mix(0.452179, 0.482574, s - 5.0);
  if (s < 7.0) return mix(0.482574, 0.497467, s - 6.0);
  if (s < 8.0) return mix(0.497467, 0.501953, s - 7.0);
  if (s < 9.0) return mix(0.501953, 0.506104, s - 8.0);
  if (s < 10.0) return mix(0.506104, 0.52066, s - 9.0);
  if (s < 11.0) return mix(0.52066, 0.550323, s - 10.0);
  if (s < 12.0) return mix(0.550323, 0.60849, s - 11.0);
  if (s < 13.0) return mix(0.60849, 0.706772, s - 12.0);
  if (s < 14.0) return mix(0.706772, 0.804932, s - 13.0);
  if (s < 15.0) return mix(0.804932, 0.903259, s - 14.0);
  if (s < 16.0) return mix(0.903259, 1.0, s - 15.0);
  return 1.0;
}

float cdf_line(float s) {
  s *= 16.0;
  if (s < 1.0) return mix(0.0, 0.0625, s - 0.0);
  if (s < 2.0) return mix(0.0625, 0.125, s - 1.0);
  if (s < 3.0) return mix(0.125, 0.1875, s - 2.0);
  if (s < 4.0) return mix(0.1875, 0.25, s - 3.0);
  if (s < 5.0) return mix(0.25, 0.3125, s - 4.0);
  if (s < 6.0) return mix(0.3125, 0.375, s - 5.0);
  if (s < 7.0) return mix(0.375, 0.4375, s - 6.0);
  if (s < 8.0) return mix(0.4375, 0.5, s - 7.0);
  if (s < 9.0) return mix(0.5, 0.5625, s - 8.0);
  if (s < 10.0) return mix(0.5625, 0.625, s - 9.0);
  if (s < 11.0) return mix(0.625, 0.6875, s - 10.0);
  if (s < 12.0) return mix(0.6875, 0.75, s - 11.0);
  if (s < 13.0) return mix(0.75, 0.8125, s - 12.0);
  if (s < 14.0) return mix(0.8125, 0.875, s - 13.0);
  if (s < 15.0) return mix(0.875, 0.9375, s - 14.0);
  if (s < 16.0) return mix(0.9375, 1.0, s - 15.0);
  return 1.0;
}

float cdf_square(float s) {
  s *= 16.0;
  if (s < 1.0) return mix(0.0, 0.003906, s - 0.0);
  if (s < 2.0) return mix(0.003906, 0.015625, s - 1.0);
  if (s < 3.0) return mix(0.015625, 0.035156, s - 2.0);
  if (s < 4.0) return mix(0.035156, 0.0625, s - 3.0);
  if (s < 5.0) return mix(0.0625, 0.097656, s - 4.0);
  if (s < 6.0) return mix(0.097656, 0.140625, s - 5.0);
  if (s < 7.0) return mix(0.140625, 0.191406, s - 6.0);
  if (s < 8.0) return mix(0.191406, 0.25, s - 7.0);
  if (s < 9.0) return mix(0.25, 0.316406, s - 8.0);
  if (s < 10.0) return mix(0.316406, 0.390625, s - 9.0);
  if (s < 11.0) return mix(0.390625, 0.472656, s - 10.0);
  if (s < 12.0) return mix(0.472656, 0.5625, s - 11.0);
  if (s < 13.0) return mix(0.5625, 0.660156, s - 12.0);
  if (s < 14.0) return mix(0.660156, 0.765625, s - 13.0);
  if (s < 15.0) return mix(0.765625, 0.878906, s - 14.0);
  if (s < 16.0) return mix(0.878906, 1.0, s - 15.0);
  return 1.0;
}

float cdf_diamond(float s) {
  s *= 16.0;
  if (s < 1.0) return mix(0.0, 0.008057, s - 0.0);
  if (s < 2.0) return mix(0.008057, 0.031738, s - 1.0);
  if (s < 3.0) return mix(0.031738, 0.071045, s - 2.0);
  if (s < 4.0) return mix(0.071045, 0.125977, s - 3.0);
  if (s < 5.0) return mix(0.125977, 0.196533, s - 4.0);
  if (s < 6.0) return mix(0.196533, 0.282715, s - 5.0);
  if (s < 7.0) return mix(0.282715, 0.384521, s - 6.0);
  if (s < 8.0) return mix(0.384521, 0.501953, s - 7.0);
  if (s < 9.0) return mix(0.501953, 0.618896, s - 8.0);
  if (s < 10.0) return mix(0.618896, 0.720215, s - 9.0);
  if (s < 11.0) return mix(0.720215, 0.805908, s - 10.0);
  if (s < 12.0) return mix(0.805908, 0.875977, s - 11.0);
  if (s < 13.0) return mix(0.875977, 0.93042, s - 12.0);
  if (s < 14.0) return mix(0.93042, 0.969238, s - 13.0);
  if (s < 15.0) return mix(0.969238, 0.992432, s - 14.0);
  if (s < 16.0) return mix(0.992432, 1.0, s - 15.0);
  return 1.0;
}

float dl_halftone(vec2 p, int kind) {
  float a = radians(P_ANGLE);
  vec2 q = mat2(cos(a), -sin(a), sin(a), cos(a)) * (p + 0.5) / max(2.0, P_CELL);
  vec2 d = abs(fract(q) - 0.5);
  if (kind == 1) return cdf_line(d.y * 2.0 * 0.999);
  if (kind == 2) return cdf_square(max(d.x, d.y) * 2.0 * 0.999);
  if (kind == 3) return cdf_diamond((d.x + d.y) * 0.999);
  float s = (d.x + d.y <= 0.5) ? dot(d, d) * 2.0 : 1.0 - dot(0.5 - d, 0.5 - d) * 2.0;
  return cdf_dot(s * 0.999);
}

int paletteSize(int p) {
  if (p == 0) return 2;
  if (p == 1) return 2;
  if (p == 2) return 4;
  if (p == 3) return 8;
  if (p == 4) return 4;
  if (p == 5) return 4;
  if (p == 6) return 4;
  if (p == 7) return 4;
  if (p == 8) return 16;
  if (p == 9) return 16;
  if (p == 10) return 16;
  if (p == 11) return 15;
  if (p == 12) return 4;
  if (p == 13) return 6;
  if (p == 14) return 5;
  if (p == 15) return 4;
  if (p == 16) return 4;
  return CUSTOM_COUNT;
}

