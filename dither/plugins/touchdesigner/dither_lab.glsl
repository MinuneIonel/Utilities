// Generated by plugins/generate.ts. create_dither_lab.py builds a component
// with custom parameters wired to these uniforms.

uniform vec4 uParams0; // algorithm, pixel size, strength, halftone cell
uniform vec4 uParams1; // angle, brightness, contrast, gamma
uniform vec4 uParams2; // saturation, invert, palette, color match
uniform vec4 uParams3; // custom count, time
uniform vec4 uCustom1;
uniform vec4 uCustom2;
uniform vec4 uCustom3;
uniform vec4 uCustom4;
uniform vec4 uCustom5;
uniform vec4 uCustom6;
uniform vec4 uCustom7;
uniform vec4 uCustom8;

out vec4 fragColor;

#define SAMPLE(uv) texture(sTD2DInputs[0], uv)
#define RENDER_SIZE uTDOutputInfo.res.zw
#define TIME_SECONDS uParams3.y
#define CUSTOM_COUNT int(uParams3.x + 0.5)
#define CUSTOM_COLOR_1 uCustom1.rgb
#define CUSTOM_COLOR_2 uCustom2.rgb
#define CUSTOM_COLOR_3 uCustom3.rgb
#define CUSTOM_COLOR_4 uCustom4.rgb
#define CUSTOM_COLOR_5 uCustom5.rgb
#define CUSTOM_COLOR_6 uCustom6.rgb
#define CUSTOM_COLOR_7 uCustom7.rgb
#define CUSTOM_COLOR_8 uCustom8.rgb
#define P_ALGORITHM int(uParams0.x + 0.5)
#define P_PIXEL uParams0.y
#define P_STRENGTH uParams0.z
#define P_CELL uParams0.w
#define P_ANGLE uParams1.x
#define P_BRIGHTNESS uParams1.y
