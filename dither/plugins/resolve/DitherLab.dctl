DEFINE_UI_PARAMS(pixelSize, Pixel Size, DCTLUI_SLIDER_INT, 3, 1, 32, 1)
DEFINE_UI_PARAMS(strength, Strength, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 1.5, 0.01)
DEFINE_UI_PARAMS(cellSize, Halftone Cell, DCTLUI_SLIDER_FLOAT, 6.0, 2.0, 32.0, 0.5)
DEFINE_UI_PARAMS(angle, Halftone Angle, DCTLUI_SLIDER_FLOAT, 45.0, 0.0, 90.0, 1.0)
DEFINE_UI_PARAMS(brightness, Brightness, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(contrast, Contrast, DCTLUI_SLIDER_FLOAT, 0.0, -100.0, 100.0, 1.0)
DEFINE_UI_PARAMS(gammaValue, Gamma, DCTLUI_SLIDER_FLOAT, 1.0, 0.2, 3.0, 0.01)
DEFINE_UI_PARAMS(saturation, Saturation, DCTLUI_SLIDER_FLOAT, 1.0, 0.0, 2.0, 0.01)
DEFINE_UI_PARAMS(invert, Invert, DCTLUI_CHECK_BOX, 0)
DEFINE_UI_PARAMS(colorMatch, Color Match, DCTLUI_COMBO_BOX, 0, { COLORMATCH_0, COLORMATCH_1, COLORMATCH_2 }, { Perceptual, RGB, Brightness only })

