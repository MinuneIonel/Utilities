// Dither Lab for DaVinci Resolve (DCTL).
// Generated by plugins/generate.ts; do not edit by hand.
// Ordered, noise, halftone and threshold dithering to the app's palettes.
// Error diffusion processes pixels in sequence, so it has no DCTL version.

DEFINE_UI_PARAMS(algorithm, Algorithm, DCTLUI_COMBO_BOX, 2, { ALGORITHM_0, ALGORITHM_1, ALGORITHM_2, ALGORITHM_3, ALGORITHM_4, ALGORITHM_5, ALGORITHM_6, ALGORITHM_7, ALGORITHM_8, ALGORITHM_9, ALGORITHM_10 }, { Bayer 2x2, Bayer 4x4, Bayer 8x8, Bayer 16x16, Blue noise IGN, White noise, Halftone dots, Halftone lines, Halftone squares, Halftone diamonds, Threshold })
