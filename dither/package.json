{
  "name": "dither",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:photoshop": "vite build --config plugins/photoshop/vite.config.ts",
    "plugins": "node --experimental-strip-types plugins/generate.ts && npm run build:photoshop"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
